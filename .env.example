# Copy to .env and adjust. Everything has a generated default except secrets,
# which the compose file warns about if missing.

# --- API ---
# Port the api container listens on inside the stack. Exposed on the host via
# the `ports:` mapping in docker-compose.yml.
APP_PORT=8080
# Public base URL used to build shortUrl links returned by the API.
BASE_URL=http://localhost:8083
# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL service (compose) ---
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener_dev
POSTGRES_DB=urlshortener
# Connection string from inside the compose network.
DATABASE_URL=postgres://urlshortener:urlshortener_dev@pg:5432/urlshortener

# --- Redis service (used from stage 12) ---
REDIS_ADDR=redis:6379
# Key/stream prefixes so the dev DB does not collide with the compose stack.
REDIS_KEY_PREFIX=us:
REDIS_STREAM=us:events